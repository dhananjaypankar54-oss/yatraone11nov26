PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=yatraone
DB_USER=root
DB_PASSWORD=abc123

JWT_SECRET=
JWT_EXPIRES_IN=1d

CLIENT_URL=http://localhost:5173

# Routing provider: osrm | graphhopper | openrouteservice | (blank = straight-line estimate, flagged ESTIMATED)
ROUTING_PROVIDER=
ROUTING_API_KEY=
ROUTING_BASE_URL=

# Bus arrival radius in metres; GPS older than this many seconds is STALE / OFFLINE
ARRIVAL_RADIUS_M=60
LIVE_SECONDS=15
RECENT_SECONDS=60
STALE_SECONDS=300

# Set true ONLY in development to seed the DEVELOPMENT DATA users (see seed.sql / README)
ALLOW_DEV_SEED=true

# ---- THE ONLY ADMIN ACCOUNT ----
# Applied on every server start. Nobody can change these from the app; edit this file and restart to change them.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
