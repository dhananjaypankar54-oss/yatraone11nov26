{
  "name": "yatraone",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "npm --prefix server run dev",
    "build": "vite build",
    "preview": "vite preview",
    "install:all": "npm install && npm --prefix server install",
    "db:setup": "npm --prefix server run db:setup"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "framer-motion": "^11.2.10",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.24.0",
    "socket.io-client": "^4.7.5",
    "zod": "^3.23.8",
    "@hookform/resolvers": "^3.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "vite": "^5.3.1"
  }
}
